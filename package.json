{
  "name": "ejdcard",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ejdcard/web",
    "dev:web": "npm run dev -w @ejdcard/web",
    "dev:worker": "npm run dev -w @ejdcard/worker",
    "build": "npm run build -w @ejdcard/web && npm run build -w @ejdcard/worker",
    "build:web": "npm run build -w @ejdcard/web",
    "build:worker": "npm run build -w @ejdcard/worker",
    "lint": "npm run lint -w @ejdcard/web"
  },
  "engines": {
    "node": ">=20"
  }
}
